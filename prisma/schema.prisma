// Base de donnees de 2MT - Shopping.
// Dev local : SQLite (aucun service externe). Production : on bascule sur
// Postgres (Neon) en changeant "provider" + DATABASE_URL, comme pour UnlockPro.
//
// Les montants sont stockes en FRANCS CFA ENTIERS (le FCFA n'a pas de centimes).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Un article de la boutique (chaussure ou cosmetique).
model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  category    String // "CHAUSSURES" | "COSMETIQUES"
  description String   @default("")
  price       Int // prix de vente en FCFA
  cost        Int      @default(0) // cout d'achat en FCFA (sert au calcul de marge)
  stock       Int      @default(0)
  sizes       String   @default("") // variantes separees par virgule : "38,39,40" ou "Rouge,Noir"
  imageData   String? // photo principale en Data URL (base64)
  active      Boolean  @default(true) // visible dans la boutique
  archived    Boolean  @default(false) // archive : retire de la boutique ET de la liste, mais restaurable
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())

  variants Variant[]
  items    OrderItem[]
}

// Une variete d'un produit (ex. une pointure, une contenance, une couleur).
// Chaque variete a SON stock et SA photo.
model Variant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String // ex. "Pointure 39", "Sauvage 100ml", "Rouge"
  stock     Int      @default(0)
  imageData String? // photo propre a la variete (sinon on retombe sur celle du produit)
  active    Boolean  @default(true)
  position  Int      @default(0) // ordre d'affichage
  createdAt DateTime @default(now())
}

// Une commande passee par un client depuis la boutique.
model Order {
  id            String   @id @default(cuid())
  publicId      String   @unique // reference courte montree au client (ex. 2MT-7F3K9Q)
  customerName  String
  customerPhone String
  quartier      String // zone de livraison a Bamako
  note          String   @default("")
  status        String   @default("NOUVELLE") // NOUVELLE | CONFIRMEE | EN_LIVRAISON | LIVREE | ANNULEE
  paymentMethod String   @default("LIVRAISON") // LIVRAISON (paiement a la livraison) ; MOBILE_MONEY plus tard
  itemsTotal    Int // somme des articles (FCFA)
  deliveryFee   Int      @default(0) // frais de livraison (FCFA)
  total         Int // itemsTotal + deliveryFee
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items OrderItem[]
}

// Une ligne de commande (un article x une quantite). On fige le nom et le prix.
model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  name      String
  price     Int // prix unitaire fige (FCFA)
  cost      Int      @default(0) // cout unitaire fige (FCFA), pour le calcul de marge
  quantity  Int
  variant   String   @default("") // libelle de la variete choisie (fige)
  variantId String? // variete choisie (pour decompter le bon stock)
}

// Parametres de la boutique (une seule ligne, id = "main").
model Setting {
  id             String @id @default("main")
  shopName       String @default("2MT - Shopping")
  whatsapp       String @default("") // numero WhatsApp des commandes (format international, ex. 223XXXXXXXX)
  deliveryFee    Int    @default(1000) // frais de livraison Bamako par defaut (FCFA)
  partnerAPct    Int    @default(60) // part de l'associe principal (%)
  adBudget       Int    @default(0) // depenses pub du mois (FCFA), pour le calcul du benefice net
}

// Base de donnees de 2MT - Shopping.
// Dev local : SQLite (aucun service externe). Production : on bascule sur
// Postgres (Neon) en changeant "provider" + DATABASE_URL, comme pour UnlockPro.
//
// Les montants sont stockes en FRANCS CFA ENTIERS (le FCFA n'a pas de centimes).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Un article de la boutique (chaussure ou cosmetique).
model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  category    String // "CHAUSSURES" | "COSMETIQUES"
  description String   @default("")
  price       Int // prix de vente en FCFA
  cost        Int      @default(0) // cout d'achat en FCFA (sert au calcul de marge)
  stock       Int      @default(0)
  sizes       String   @default("") // variantes separees par virgule : "38,39,40" ou "Rouge,Noir"
  imageData   String? // photo principale en Data URL (base64)
  active      Boolean  @default(true) // visible dans la boutique
  archived    Boolean  @default(false) // archive : retire de la boutique ET de la liste, mais restaurable
  featured    Boolean  @default(false)
  caisseRef   String? // lien avec le produit de la caisse Alimentation Tounkara (voir CaisseProduct.ref)
  ratingAvg   Float    @default(0) // note moyenne des clients (1 a 5), 0 = pas encore notee
  ratingCount Int      @default(0) // nombre de notes
  vendorId    String? // null = produit de 2MT ; sinon produit d'un vendeur partenaire
  vendor      Vendor?  @relation(fields: [vendorId], references: [id])
  status      String   @default("APPROVED") // APPROVED | PENDING (a valider) | REJECTED
  rejectReason String  @default("")
  createdAt   DateTime @default(now())

  variants Variant[]
  items    OrderItem[]
  images   ProductImage[] // photos supplementaires (la principale reste imageData)
  ratings  ProductRating[]
}

// Note donnee par un client (1 a 5 etoiles). Un vote par visiteur et par
// produit (visiteur reconnu par un cookie anonyme) : revoter remplace la note.
model ProductRating {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  voterId   String
  stars     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@unique([productId, voterId])
}

// Photos supplementaires d'un produit (galerie), dans l'ordre d'affichage.
model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageData String // Data URL (base64)
  position  Int     @default(0)

  @@index([productId])
}

// Une variete d'un produit (ex. une pointure, une contenance, une couleur).
// Chaque variete a SON stock et SA photo.
model Variant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String // ex. "Pointure 39", "Sauvage 100ml", "Rouge"
  stock     Int      @default(0)
  imageData String? // photo propre a la variete (sinon on retombe sur celle du produit)
  active    Boolean  @default(true)
  position  Int      @default(0) // ordre d'affichage
  createdAt DateTime @default(now())
}

// Une commande passee par un client depuis la boutique.
model Order {
  id            String   @id @default(cuid())
  publicId      String   @unique // reference courte montree au client (ex. 2MT-7F3K9Q)
  customerName  String
  customerPhone String
  quartier      String // zone de livraison a Bamako
  note          String   @default("")
  status        String   @default("NOUVELLE") // NOUVELLE | CONFIRMEE | EN_LIVRAISON | LIVREE | ANNULEE
  paymentMethod String   @default("LIVRAISON") // LIVRAISON (paiement a la livraison) ; MOBILE_MONEY plus tard
  itemsTotal    Int // somme des articles (FCFA)
  deliveryFee   Int      @default(0) // frais de livraison (FCFA)
  deliveryLat   Float? // adresse choisie sur la carte par le client
  deliveryLng   Float?
  deliveryKm    Float? // distance depuis le point de depart de la boutique
  deliveryToConfirm Boolean @default(false) // trop loin : frais a convenir avec le vendeur
  total         Int // itemsTotal + deliveryFee
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items OrderItem[]
}

// Une ligne de commande (un article x une quantite). On fige le nom et le prix.
model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  name      String
  price     Int // prix unitaire fige (FCFA)
  cost      Int      @default(0) // cout unitaire fige (FCFA), pour le calcul de marge
  quantity  Int
  variant   String   @default("") // libelle de la variete choisie (fige)
  variantId String? // variete choisie (pour decompter le bon stock)
}

// Parametres de la boutique (une seule ligne, id = "main").
model Setting {
  id             String @id @default("main")
  shopName       String @default("2MT - Shopping")
  whatsapp       String @default("") // numero WhatsApp des commandes (format international, ex. 223XXXXXXXX)
  deliveryFee    Int    @default(1000) // frais par defaut, si le point de depart n'est pas regle (FCFA)
  shopLat        Float? // point de depart des livraisons (regle sur la carte)
  shopLng        Float?
  partnerAPct    Int    @default(60) // part de l'associe principal (%)
  adBudget       Int    @default(0) // depenses pub du mois (FCFA), pour le calcul du benefice net
  metaPixelId    String @default("") // ID du Pixel Facebook (Meta), vide = pas de suivi

  // Associes : noms affiches + mots de passe (hash). Si le hash est vide, on
  // retombe sur la variable d'environnement correspondante.
  ownerName       String @default("Propriétaire")
  partnerName     String @default("Partenaire")
  ownerPassHash   String @default("") // hash scrypt "sel:hash" ; vide => ADMIN_PASSWORD
  partnerPassHash String @default("") // hash scrypt "sel:hash" ; vide => PARTNER_PASSWORD
}

// Produits de la caisse « Alimentation Tounkara » (application du magasin),
// envoyes depuis un fichier d'export. Sert a importer des produits dans la
// boutique sans les retaper. Chaque envoi remplace toute la liste.
model CaisseProduct {
  ref         String   @id // code-barres, sinon "id-<id de la caisse>"
  barcode     String   @default("")
  name        String
  category    String   @default("")
  description String   @default("")
  price       Int      @default(0) // prix de vente en caisse (FCFA)
  cost        Int      @default(0) // prix d'achat (FCFA)
  stock       Int      @default(0)
  unit        String   @default("")
  updatedAt   DateTime @default(now())
}

// Produits reperes (ex. dans les tendances Google Shopping) que l'on pense
// vendre bientot : liste de travail de l'admin, pas visible des clients.
model UpcomingProduct {
  id          String   @id @default(cuid())
  name        String
  imageUrl    String   @default("")
  price       String   @default("") // prix constate, tel qu'affiche (ex. "12,99 €")
  priceFcfa   Int? // conversion indicative en FCFA
  source      String   @default("") // site marchand
  link        String   @default("")
  rating      Float?
  ratingCount Int?
  query       String   @default("") // recherche qui l'a fait trouver
  note        String   @default("")
  createdAt   DateTime @default(now())
}

// ---------- Gestion (tresorerie, achats, depenses, emprunts) ----------
// Un compte : soit de l'argent dont on dispose (TRESORERIE : caisse, Orange
// Money, banque…), soit une personne/organisme qui nous prete (PRETEUR : son
// solde = ce qu'on lui doit encore).
model FinAccount {
  id        String   @id @default(cuid())
  name      String
  kind      String // "TRESORERIE" | "PRETEUR"
  note      String   @default("")
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Une operation. Sens selon le type :
//  REVENU        : +montant sur accountId (tresorerie)
//  ACHAT/DEPENSE : paye avec accountId (tresorerie -> diminue ; preteur -> dette augmente)
//  EMPRUNT       : accountId = preteur (dette +), toAccountId = tresorerie (+)
//  REMBOURSEMENT : accountId = tresorerie (-), toAccountId = preteur (dette -)
//  TRANSFERT     : accountId -> toAccountId (deux tresoreries)
model FinEntry {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  type        String
  amount      Int // FCFA
  accountId   String
  toAccountId String?
  payee       String   @default("") // a qui l'argent a ete remis / de qui il vient
  category    String   @default("")
  description String   @default("")
  createdBy   String   @default("")
  createdAt   DateTime @default(now())

  @@index([date])
}

// Vendeur partenaire (espace vendeur). Cree par le proprietaire, sur invitation.
// Ses produits affichent « Vendu par … » et son WhatsApp (pas le panier 2MT).
model Vendor {
  id          String    @id @default(cuid())
  slug        String    @unique // adresse publique : /vendeur/<slug>
  name        String
  whatsapp    String // format international, ex. 22376000000
  description String    @default("")
  passHash    String // mot de passe de l'espace vendeur (scrypt)
  active      Boolean   @default(true) // false = suspendu : ses produits disparaissent
  maxProducts Int       @default(20)
  freeUntil   DateTime? // gratuit jusqu'a cette date (information)
  createdAt   DateTime  @default(now())
  products    Product[]
}

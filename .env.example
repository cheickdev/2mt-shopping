# ----------------------------------------------------------------------------
# Copiez ce fichier en « .env » et remplissez les valeurs.
# En mode simulation, aucune cle reelle n'est necessaire : tout fonctionne.
# ----------------------------------------------------------------------------

# Base de donnees (SQLite par defaut pour le dev ; Postgres recommande en prod)
DATABASE_URL="file:./dev.db"

# --- Fournisseur de codes (API DHRU Fusion) ---------------------------------
# Laissez PROVIDER_MODE=simulation tant que vous n'avez pas de compte grossiste.
# Passez a "live" une fois vos identifiants DHRU obtenus.
PROVIDER_MODE="simulation"
DHRU_API_URL=""
DHRU_USERNAME=""
DHRU_API_KEY=""

# --- Stripe (paiement) ------------------------------------------------------
# Laissez vide en simulation. Renseignez les cles de TEST d'abord.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Devise par defaut affichee au client
NEXT_PUBLIC_DEFAULT_CURRENCY="EUR"

# URL publique du site (SEO : canonical, OpenGraph, sitemap, liens dans les emails)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Emails transactionnels (Resend) ----------------------------------------
# Sans RESEND_API_KEY, les emails sont simules (journalises en console).
RESEND_API_KEY=""
EMAIL_FROM="UnlockPro <onboarding@resend.dev>"

# --- Back-office admin ------------------------------------------------------
# Mot de passe d'acces a /admin. En dev, la valeur par defaut est "admin".
# DEFINISSEZ une vraie valeur en production.
ADMIN_PASSWORD="admin"
# Secret de signature du cookie de session admin (chaine aleatoire longue en prod).
ADMIN_SESSION_SECRET="changez-moi-en-production"

# Secret de signature du cookie de session revendeur (a defaut, ADMIN_SESSION_SECRET).
RESELLER_SESSION_SECRET="changez-moi-aussi-en-production"

# Secret de signature du cookie de session client (a defaut, ADMIN_SESSION_SECRET).
CUSTOMER_SESSION_SECRET="changez-moi-egalement-en-production"

# ============================================================================
# Variables d'environnement de PRODUCTION (a definir chez votre hebergeur,
# ex. Vercel > Project > Settings > Environment Variables).
# Ne commitez JAMAIS ce fichier rempli. Verifiez l'etat via GET /api/health.
# ============================================================================

# --- Base de donnees : Postgres (obligatoire en production) -----------------
# Neon, Supabase, Vercel Postgres... Copiez l'URL de connexion.
# NB : passez aussi provider = "postgresql" dans prisma/schema.prisma.
DATABASE_URL="postgresql://user:password@host:5432/unlockpro?sslmode=require"

# --- URL publique du site ---------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://votre-domaine.com"

# --- Fournisseur de codes (DHRU Fusion) -------------------------------------
PROVIDER_MODE="live"
DHRU_API_URL="https://grossiste.example/api/index.php"
DHRU_USERNAME="votre_identifiant"
DHRU_API_KEY="votre_cle_dhru"

# --- Paiement (Stripe, cles LIVE) -------------------------------------------
STRIPE_SECRET_KEY="sk_live_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
# Secret du webhook declare dans le dashboard Stripe (endpoint /api/stripe/webhook).
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Emails (Resend) --------------------------------------------------------
RESEND_API_KEY="re_..."
EMAIL_FROM="UnlockPro <no-reply@votre-domaine.com>"

# --- Secrets (generez des chaines aleatoires longues et UNIQUES) ------------
# Ex. : openssl rand -hex 32
ADMIN_PASSWORD="un-mot-de-passe-admin-fort"
ADMIN_SESSION_SECRET="aleatoire-64-hex"
RESELLER_SESSION_SECRET="aleatoire-64-hex"
CUSTOMER_SESSION_SECRET="aleatoire-64-hex"

NEXT_PUBLIC_DEFAULT_CURRENCY="EUR"
